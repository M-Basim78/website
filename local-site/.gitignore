node_modules/
.cache/
verify-out/
*.png

# dist/ is the deployable artifact and is committed on purpose
!dist/

# Runtime state, created by the CMS and living in the content volume.
# The bin and the version history are per-deployment, not source.
content/.trash/
content/.history/
content/uploads/*
!content/uploads/.gitkeep

# Shop runtime data. Orders hold customer emails; content/products holds the
# paid files she sells. Neither belongs in a repository, and this one is public.
content/orders/
content/products/
