# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   node --env-file=.env cms/server.js
#
# In Coolify these are set as environment variables on the application instead,
# and this file is not deployed.

# ---------------------------------------------------------------- the editor
CMS_USER=stephanie
# node cms/hash-password.js "the password you choose"
CMS_PASSWORD_HASH=
# any long random string. Changing it signs her out of the editor.
SESSION_SECRET=

# ------------------------------------------------------------------ the site
# Where Stripe sends the buyer back to. Must be the public address.
SITE_ORIGIN=http://localhost:8184
PORT=8184

# ----------------------------------------------------------------- the shop
#
# TWO KEYPAIRS EXIST ON THE SAME STRIPE ACCOUNT.
#
#   sk_test_...  test mode. Fake cards, no real money, identical code paths.
#   sk_live_...  live mode. Real cards, real money, real customers.
#
# Develop and test against the TEST keys. The test suite refuses to run when it
# sees a live key, because a mistake there costs real money and touches her real
# customer records.
#
# Stripe dashboard -> Developers -> API keys. The "Test mode" toggle at the top
# right switches which pair you are looking at.

STRIPE_SECRET_KEY=
# Stripe dashboard -> Developers -> Webhooks -> your endpoint -> signing secret.
# For local work, `stripe listen` prints a temporary one.
STRIPE_WEBHOOK_SECRET=

# The publishable key is not needed by this server: Stripe Checkout is hosted, so
# the browser never talks to Stripe directly. Kept here only for reference.
STRIPE_PUBLISHABLE_KEY=
