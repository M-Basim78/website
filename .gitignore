# Python environment
venv/
__pycache__/
*.pyc

# The packaged backup archive (946 MB) - regenerate with verify.py
*.zip

# Where serve.js expects the unzipped archive. On this machine it is a junction
# pointing at backup/, so committing it would duplicate the entire mirror.
medpsycmoss-backup-20260727/

# Build logs
*.log

# Lighthouse HTML/JSON runs are large and reproducible with lh.mjs
local-site/reports/lh-*/

# Heavy backup payloads - kept in the zip archive, not in git.
# These exceed GitHub's practical repo limits (1.1 GB combined).
backup/pages/
backup/screenshots/
backup/assets/

# The small, text-only backup artifacts ARE tracked; see .gitignore exceptions
# below and README.md for what is and isn't in this repo.

# Screenshots dropped into the repo root for review. Never commit these:
# one of them was a personal PayPal dispute, and this repo is public.
WhatsApp Image*.jpeg
WhatsApp Image*.jpg
*.jpeg

# Credentials. This repository is public: API keys, secrets and any document
# holding them must never be committed, by any name.
*.docx
*.xlsx
*API*Key*
*api*key*
*secret*
*.env
.env*
# the template carries no secrets and should be committed
!*.env.example
!.env.example

# Customer and order exports. These hold real names, emails, addresses and
# payment records. This repository is public: never commit them.
*.csv

# Regenerated from the archive by extract-product-images.py. Derived data, and
# 12 MB of it, so it stays out of the repository.
product-images/
